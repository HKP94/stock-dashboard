# .streamlit/secrets.toml 예시 (이 파일은 커밋되는 템플릿입니다)
# 실제 사용 시: 이 파일을 secrets.toml 로 복사하고 DB_PASSWORD에 실제 비밀번호를 넣으세요.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# secrets.toml 은 .gitignore 에 포함되어 절대 커밋되지 않습니다. 비밀번호를 여기(.example)에 적지 마세요.

DB_HOST = "aws-1-ap-northeast-2.pooler.supabase.com"
DB_PORT = "6543"
DB_USER = "postgres.dpegnpmzgozvcvbqmnlt"
DB_NAME = "postgres"
DB_PASSWORD = ""   # ← 실제 Supabase DB 비밀번호를 secrets.toml(복사본)에 직접 입력
