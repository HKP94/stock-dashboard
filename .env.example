# ============================================================
# .env.example — ATLAS 환경변수 키 이름 목록
# 값은 절대 채우지 말 것. 실제 값은 .env (gitignore)에만 저장.
# ============================================================

# ── Postgres ─────────────────────────────────────────────────
DATABASE_URL=

# ── 한국투자증권 KIS OpenAPI (F1 옵션 A) ─────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_TYPE=           # 01=종합위탁, 그 외 필요 시 메모
KIS_IS_PAPER=               # true=모의투자, false=실거래

# ── DART OpenAPI (KR 재무공시) ───────────────────────────────
DART_API_KEY=

# ── Financial Modeling Prep (US 재무/컨센서스) ───────────────
FMP_API_KEY=

# ── Finnhub (US 보조 소스) ───────────────────────────────────
FINNHUB_API_KEY=

# ── Gemini API ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_BULK_MODEL=          # 종목별 뉴스 요약 (저렴 티어)
GEMINI_SYNTH_MODEL=         # 일일 시황 종합 (상위 티어)

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets (Phase 3 미러, 선택) ───────────────────────
GOOGLE_SHEETS_CREDS_JSON=   # 서비스 계정 JSON 파일 경로
GOOGLE_SHEETS_SPREADSHEET_ID=
