# ============================================================
# .env.example — ATLAS 환경변수 키 이름 목록
# 값은 절대 채우지 말 것. 실제 값은 .env (gitignore)에만 저장.
# ============================================================

# ── Postgres (Supabase Transaction Pooler) ──────────────────
# HOST/PORT/USER/NAME은 시크릿 아님. PASSWORD만 비밀.
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres            # 풀러는 보통 postgres.<project_ref> 형식
DB_PASSWORD=                # 비밀 — .env(gitignore)에만
DB_NAME=postgres

# ── 한국투자증권 KIS OpenAPI (F1 옵션 A) ─────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_TYPE=           # 01=종합위탁, 그 외 필요 시 메모
KIS_IS_PAPER=               # true=모의투자, false=실거래

# ── KB증권 OpenAPI ───────────────────────────────────────────
# 조회 전용. 주문 API는 kb_client 화이트리스트가 물리 차단한다.
# 2단계(수급 IVU10430)는 계좌 무관 API라 CI 사용 가능성 검토 중 —
# 실계좌를 앱키에 연결하는 시점에는 키 로테이트 또는 시세용/계좌용 앱 분리가 전제다.
KB_APP_KEY=
KB_APP_SECRET=

# ── DART OpenAPI (KR 재무공시) ───────────────────────────────
DART_API_KEY=

# ── Financial Modeling Prep (US 재무/컨센서스) ───────────────
FMP_API_KEY=

# ── Finnhub (US 보조 소스) ───────────────────────────────────
FINNHUB_API_KEY=

# ── FRED (시장 뉴스 보조 지표, 선택) ───────────────────────────
FRED_API_KEY=

# ── Gemini API ───────────────────────────────────────────────
# 다중 무료티어 키 풀(쉼표 구분) — 한 키가 RPD/레이트리밋으로 소진되면 다음 키로 로테이션.
GEMINI_API_KEYS=            # 예: key_aaa,key_bbb,key_ccc  (있으면 우선)
GEMINI_API_KEY=             # 단일 키(하위호환) — GEMINI_API_KEYS 없을 때만 사용
GEMINI_BULK_MODEL=          # 종목별 뉴스 요약 (저렴 티어)
GEMINI_SYNTH_MODEL=         # 일일 시황 종합 (상위 티어)
# 무료티어 레이트리밋 대응 (한도는 AI Studio 대시보드에서 확인 후 설정)
GEMINI_MIN_INTERVAL_SECONDS= # RPM 스로틀: 호출 간 최소 간격(초). 0=비활성. 예 flash-lite 15RPM→4
GEMINI_MAX_CALLS_PER_RUN=    # RPD 예산: 실행당 Gemini 호출 상한. 0=무제한. 초과분은 다음 주기 이월

# ── 텔레그램 ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets (Phase 3 미러, 선택) ───────────────────────
GOOGLE_SHEETS_CREDS_JSON=   # 서비스 계정 JSON 파일 경로
GOOGLE_SHEETS_SPREADSHEET_ID=
